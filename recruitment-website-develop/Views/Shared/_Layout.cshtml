<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " - " : "")Cổng Thông Tin Tuyển Dụng & Việc Làm</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Global Stylesheets (Bootstrap 5 & Design System) -->
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- View-specific Styles Section -->
    @RenderSection("styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        <!-- HEADER & NAVBAR -->
        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg navbar-site">
                <div class="container">
                    <!-- Brand Logo -->
                    <a class="navbar-brand-custom" href="@Url.Action("Index", "Home")">
                        <div class="brand-icon-box">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">Recruit<span>Hub</span></span>
                            <span class="brand-subtitle">Cổng Tuyển Dụng</span>
                        </div>
                    </a>

                    <!-- Mobile Menu Toggler -->
                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainCollapse" aria-controls="navbarMainCollapse" aria-expanded="false" aria-label="Chuyển đổi điều hướng">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>

                    <!-- Nav Links & Role-Based Actions -->
                    <div class="collapse navbar-collapse" id="navbarMainCollapse">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                            <li class="nav-item">
                                <a class="nav-link nav-link-site" href="@Url.Action("Index", "Home")">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-site" href="@Url.Action("Index", "Job", new { area = "" })">Việc làm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-site" href="@Url.Action("Index", "Company", new { area = "" })">Công ty</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-site" href="@Url.Action("About", "Home")">Giới thiệu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-site" href="@Url.Action("Contact", "Home")">Liên hệ</a>
                            </li>
                        </ul>

                        <!-- Right Section: Auth & User Menu -->
                        <div class="d-flex align-items-lg-center flex-column flex-lg-row gap-2">
                            @{
                                var isLoggedIn = Session["UserId"] != null;
                                var userRole = Session["UserRole"]?.ToString() ?? "";
                                var fullName = Session["FullName"]?.ToString() ?? "Người dùng";
                                var initialLetter = !string.IsNullOrWhiteSpace(fullName) ? fullName.Trim().Substring(0, 1).ToUpper() : "U";
                            }

                            @if (isLoggedIn)
                            {
                                if (userRole == "employer")
                                {
                                    <a href="@Url.Action("Create", "Job", new { area = "" })" class="btn btn-cta-post-job btn-sm">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="5" x2="12" y2="19"></line>
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                        <span>Đăng tin tuyển dụng</span>
                                    </a>
                                }
                                else if (userRole == "candidate")
                                {
                                    <a href="@Url.Action("Index", "Application", new { area = "" })" class="btn btn-outline-secondary btn-sm">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                            <polyline points="10 9 9 9 8 9"></polyline>
                                        </svg>
                                        <span>Việc đã nộp</span>
                                    </a>
                                }

                                <!-- User Dropdown -->
                                <div class="dropdown">
                                    <button class="user-menu-btn dropdown-toggle border-0" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="user-avatar-circle">
                                            @initialLetter
                                        </div>
                                        <span class="user-name-text">@fullName</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userMenuDropdown">
                                        <li class="dropdown-header-custom">
                                            <div class="dropdown-user-fullname">@fullName</div>
                                            <div class="dropdown-user-role">
                                                @(userRole == "employer" ? "Nhà tuyển dụng" : (userRole == "candidate" ? "Ứng viên" : "Quản trị viên"))
                                            </div>
                                        </li>

                                        @if (userRole == "candidate")
                                        {
                                            <li>
                                                <a class="dropdown-item dropdown-item-custom" href="@Url.Action("Profile", "Candidate", new { area = "" })">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                        <circle cx="12" cy="7" r="4"></circle>
                                                    </svg>
                                                    <span>Hồ sơ & CV của tôi</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item dropdown-item-custom" href="@Url.Action("Index", "Application", new { area = "" })">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="9 11 12 14 22 4"></polyline>
                                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                                    </svg>
                                                    <span>Lịch sử ứng tuyển</span>
                                                </a>
                                            </li>
                                        }
                                        else if (userRole == "employer")
                                        {
                                            <li>
                                                <a class="dropdown-item dropdown-item-custom" href="@Url.Action("Index", "Job", new { area = "" })">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="8" y1="6" x2="21" y2="6"></line>
                                                        <line x1="8" y1="12" x2="21" y2="12"></line>
                                                        <line x1="8" y1="18" x2="21" y2="18"></line>
                                                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                                    </svg>
                                                    <span>Quản lý tin tuyển dụng</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item dropdown-item-custom" href="@Url.Action("Index", "Application", new { area = "" })">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                        <circle cx="9" cy="7" r="4"></circle>
                                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                    </svg>
                                                    <span>Hồ sơ ứng viên nộp</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item dropdown-item-custom" href="@Url.Action("Profile", "Company", new { area = "" })">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                                    </svg>
                                                    <span>Thông tin công ty</span>
                                                </a>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item dropdown-item-custom text-danger" href="@Url.Action("Logout", "Account", new { area = "" })">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                                    <polyline points="16 17 21 12 16 7"></polyline>
                                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                                </svg>
                                                <span>Đăng xuất</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary btn-sm">
                                    Đăng nhập
                                </a>
                                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-sm">
                                    Đăng ký
                                </a>
                                <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary btn-sm d-none d-xl-inline-flex">
                                    Dành cho Nhà tuyển dụng
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- FLASH NOTIFICATIONS (TempData) -->
        <div class="container flash-alert-container mt-3">
            @if (TempData["Success"] != null && ViewBag.HideGlobalAlert != true)
            {
                <div class="flash-alert flash-alert-success" data-auto-dismiss="true" role="alert">
                    <div class="flash-alert-content">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>@TempData["Success"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" data-dismiss="flash-alert" aria-label="Đóng"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="flash-alert flash-alert-danger" data-auto-dismiss="false" role="alert">
                    <div class="flash-alert-content">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                        <span>@TempData["Error"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" data-dismiss="flash-alert" aria-label="Đóng"></button>
                </div>
            }

            @if (TempData["Warning"] != null)
            {
                <div class="flash-alert flash-alert-warning" data-auto-dismiss="true" role="alert">
                    <div class="flash-alert-content">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <span>@TempData["Warning"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" data-dismiss="flash-alert" aria-label="Đóng"></button>
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="flash-alert flash-alert-info" data-auto-dismiss="true" role="alert">
                    <div class="flash-alert-content">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>@TempData["Info"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" data-dismiss="flash-alert" aria-label="Đóng"></button>
                </div>
            }
        </div>

        <!-- MAIN BODY CONTENT -->
        <main class="main-content" id="mainContent">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="site-footer">
            <div class="container">
                <div class="row g-4">
                    <!-- Col 1: Platform Brand & Info -->
                    <div class="col-lg-4 col-md-6">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="brand-icon-box" style="width: 32px; height: 32px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                            </div>
                            <span class="brand-title fs-5">Recruit<span>Hub</span></span>
                        </div>
                        <p class="footer-brand-desc">
                            Nền tảng kết nối nhân tài và nhà tuyển dụng hàng đầu. Kiến tạo cơ hội nghề nghiệp vững chắc và giải pháp tuyển dụng tối ưu cho doanh nghiệp.
                        </p>
                        <div class="footer-contact-item">
                            <svg class="footer-contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            <span>Hotline: 1900 8888 (8:00 - 18:00)</span>
                        </div>
                        <div class="footer-contact-item">
                            <svg class="footer-contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>Email: support@recruithub.vn</span>
                        </div>
                    </div>

                    <!-- Col 2: For Candidates -->
                    <div class="col-lg-2 col-md-6 col-6">
                        <h6 class="footer-heading">Dành cho Ứng viên</h6>
                        <ul class="footer-links">
                            <li><a href="@Url.Action("Index", "Job")">Tìm việc làm</a></li>
                            <li><a href="@Url.Action("Index", "Company")">Danh sách công ty</a></li>
                            <li><a href="@Url.Action("Register", "Account")">Tạo hồ sơ xin việc</a></li>
                            <li><a href="@Url.Action("Index", "Home")#categories">Ngành nghề nổi bật</a></li>
                        </ul>
                    </div>

                    <!-- Col 3: For Employers -->
                    <div class="col-lg-3 col-md-6 col-6">
                        <h6 class="footer-heading">Dành cho Nhà tuyển dụng</h6>
                        <ul class="footer-links">
                            <li><a href="@Url.Action("Register", "Account")">Đăng tin tuyển dụng</a></li>
                            <li><a href="@Url.Action("Login", "Account")">Tìm kiếm nhân tài</a></li>
                            <li><a href="@Url.Action("About", "Home")">Giải pháp tuyển dụng</a></li>
                            <li><a href="@Url.Action("Contact", "Home")">Báo giá dịch vụ</a></li>
                        </ul>
                    </div>

                    <!-- Col 4: Platform & Support -->
                    <div class="col-lg-3 col-md-6">
                        <h6 class="footer-heading">Về chúng tôi</h6>
                        <ul class="footer-links">
                            <li><a href="@Url.Action("About", "Home")">Giới thiệu nền tảng</a></li>
                            <li><a href="@Url.Action("Contact", "Home")">Liên hệ hỗ trợ</a></li>
                            <li><a href="@Url.Action("About", "Home")">Điều khoản sử dụng</a></li>
                            <li><a href="@Url.Action("About", "Home")">Chính sách bảo mật</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Footer Bottom Bar -->
                <div class="footer-bottom">
                    <div>
                        &copy; @DateTime.Now.Year <strong>RecruitHub</strong>. Bản quyền thuộc về Nhóm Phát Triển Website Tuyển Dụng.
                    </div>
                    <div class="d-flex gap-3">
                        <a href="@Url.Action("About", "Home")" class="text-decoration-none text-muted">Quy chế hoạt động</a>
                        <span>&bull;</span>
                        <a href="@Url.Action("Contact", "Home")" class="text-decoration-none text-muted">Hỗ trợ</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Global Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/site")

    <!-- View-specific Scripts Section -->
    @RenderSection("scripts", required: false)
</body>
</html>
