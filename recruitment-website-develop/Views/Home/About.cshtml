@{
    ViewBag.Title = "Giới thiệu nền tảng";
}

<div class="container py-3">
    <div class="bento-card p-4 p-md-5 mb-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-semibold mb-3">Về chúng tôi</span>
        <h1 class="display-6 fw-bold mb-3">Cổng Thông Tin Tuyển Dụng RecruitHub</h1>
        <p class="lead text-muted mb-4">
            RecruitHub là cầu nối tin cậy giữa các doanh nghiệp đang tìm kiếm nhân tài và các ứng viên khao khát cơ hội phát triển sự nghiệp vững chắc.
        </p>

        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h5 class="fw-bold text-primary mb-2">Sứ mệnh</h5>
                    <p class="text-secondary small mb-0">Rút ngắn khoảng cách giữa ứng viên và nhà tuyển dụng thông qua nền tảng tuyển dụng minh bạch, nhanh chóng và chính xác.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h5 class="fw-bold text-primary mb-2">Tầm nhìn</h5>
                    <p class="text-secondary small mb-0">Trở thành giải pháp quản trị tuyển dụng và tìm kiếm việc làm hàng đầu dành cho các bạn trẻ và doanh nghiệp năng động.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h5 class="fw-bold text-primary mb-2">Giá trị cốt lõi</h5>
                    <p class="text-secondary small mb-0">Minh bạch - Hiệu quả - Tận tâm - Công nghệ tiên phong hỗ trợ người dùng tối đa trong mọi giai đoạn tuyển dụng.</p>
                </div>
            </div>
        </div>
    </div>
</div>