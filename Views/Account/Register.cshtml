@model recruitment_website.Models.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản";
    var isEmployer = Model != null && Model.Role == "employer";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/auth.css" />
}

<div class="auth-wrapper">
    <div class="auth-card auth-card-register">
        <div class="auth-header">
            <div class="auth-icon-badge">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>
            <h2 class="auth-title">Đăng ký tài khoản</h2>
            <p class="auth-subtitle">Chọn vai trò của bạn và tạo tài khoản nhanh chóng</p>
        </div>

        @* Hiển thị lỗi chung cấp Model nếu xảy ra sự cố (ví dụ transaction rollback) *@
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null && ViewData.ModelState[string.Empty].Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <svg class="bi flex-shrink-0 me-2" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                </svg>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form", id = "registerForm", role = "form", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            @* 1. Lựa chọn vai trò (Role): candidate vs employer *@
            <div class="mb-4">
                <label class="form-label d-block mb-2">Bạn tham gia với tư cách:</label>
                <div class="role-options-grid">
                    <label class="role-option" for="roleCandidate">
                        <input type="radio" name="Role" id="roleCandidate" value="candidate" @(!isEmployer ? "checked=\"checked\"" : "") />
                        <div class="role-card-content">
                            <div class="role-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <div class="role-name">Ứng viên</div>
                            <p class="role-desc">Tìm kiếm việc làm & cơ hội nghề nghiệp</p>
                        </div>
                    </label>

                    <label class="role-option" for="roleEmployer">
                        <input type="radio" name="Role" id="roleEmployer" value="employer" @(isEmployer ? "checked=\"checked\"" : "") />
                        <div class="role-card-content">
                            <div class="role-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                            </div>
                            <div class="role-name">Nhà tuyển dụng</div>
                            <p class="role-desc">Đăng tin tuyển dụng & tìm nhân tài</p>
                        </div>
                    </label>
                </div>
                @Html.ValidationMessageFor(m => m.Role, "", new { @class = "field-validation-error" })
            </div>

            @* 2. Thông tin tài khoản chung *@
            <div class="row">
                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.Email, "Địa chỉ Email", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" + (ViewData.ModelState["Email"] != null && ViewData.ModelState["Email"].Errors.Count > 0 ? " input-validation-error" : ""), placeholder = "name@example.com", type = "email", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                </div>

                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label" })
                    <div class="input-group">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" + (ViewData.ModelState["Password"] != null && ViewData.ModelState["Password"].Errors.Count > 0 ? " input-validation-error" : ""), placeholder = "Tối thiểu 6 ký tự", autocomplete = "new-password" })
                        <button class="btn btn-outline-secondary btn-password-toggle" type="button" title="Hiện mật khẩu">
                            <svg class="icon-eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="icon-eye-hide d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                @* 3. FullName (dùng chung cho cả 2 role) *@
                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.FullName, "Họ và tên", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" + (ViewData.ModelState["FullName"] != null && ViewData.ModelState["FullName"].Errors.Count > 0 ? " input-validation-error" : ""), placeholder = "Nguyễn Văn A" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-validation-error" })
                </div>
            </div>

            @* 4. Nhóm trường dành riêng cho Nhà tuyển dụng (ẩn/hiện tự động bằng JavaScript) *@
            <div id="employerFields" class="employer-fields-box" style="@(isEmployer ? "display: block;" : "display: none;")">
                <div class="employer-fields-title">
                    <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    Thông tin công ty / Doanh nghiệp
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.CompanyName, "Tên công ty", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control" + (ViewData.ModelState["CompanyName"] != null && ViewData.ModelState["CompanyName"].Errors.Count > 0 ? " input-validation-error" : ""), id = "companyNameInput", placeholder = "Ví dụ: Công ty TNHH Giải Pháp Công Nghệ ABC" })
                    @Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "field-validation-error" })
                </div>

                <div class="mb-1">
                    @Html.LabelFor(m => m.TaxCode, "Mã số thuế (nếu có)", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.TaxCode, new { @class = "form-control" + (ViewData.ModelState["TaxCode"] != null && ViewData.ModelState["TaxCode"].Errors.Count > 0 ? " input-validation-error" : ""), id = "taxCodeInput", placeholder = "Ví dụ: 0101234567" })
                    @Html.ValidationMessageFor(m => m.TaxCode, "", new { @class = "field-validation-error" })
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-auth-submit w-100 mt-2">
                Đăng ký tài khoản
            </button>
        }

        <div class="auth-footer-links">
            Đã có tài khoản?
            <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/js/auth.js"></script>
}
