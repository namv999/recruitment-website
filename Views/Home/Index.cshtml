@{
    ViewBag.Title = "Trang chủ - Cổng Tuyển Dụng & Tìm Kiếm Việc Làm";
}

<div class="container py-2">
    <!-- HERO SECTION -->
    <div class="row align-items-center mb-5 g-4">
        <div class="col-lg-7">
            <div class="pe-lg-4">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold mb-3">
                    🚀 Nền tảng kết nối nhân sự thời đại số
                </span>
                <h1 class="display-5 fw-extrabold text-dark mb-3 tracking-tight">
                    Tìm kiếm cơ hội việc làm <span class="text-primary">lý tưởng</span> cho tương lai của bạn
                </h1>
                <p class="lead text-muted mb-4 fs-6">
                    Khám phá hàng ngàn việc làm chất lượng cao từ các doanh nghiệp hàng đầu. Kết nối thông minh, ứng tuyển dễ dàng và nâng tầm sự nghiệp ngay hôm nay.
                </p>

                <!-- QUICK SEARCH BAR -->
                <div class="bento-card bento-card-compact p-3 border shadow-sm">
                    @using (Html.BeginForm("Index", "Job", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
                    {
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-0 text-muted ps-2">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                </span>
                                <input type="text" name="keyword" class="form-control border-0 shadow-none ps-1" placeholder="Vị trí, chức danh hoặc từ khóa..." />
                            </div>
                        </div>
                        <div class="col-md-4 border-start-md">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-0 text-muted ps-2">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                </span>
                                <select name="location" class="form-select border-0 shadow-none ps-1 text-muted">
                                    <option value="">Tất cả địa điểm</option>
                                    <option value="Hà Nội">Hà Nội</option>
                                    <option value="Hồ Chí Minh">TP. Hồ Chí Minh</option>
                                    <option value="Đà Nẵng">Đà Nẵng</option>
                                    <option value="Remote">Làm việc từ xa (Remote)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <span>Tìm kiếm</span>
                            </button>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 text-muted fs-7">
                    <span class="fw-semibold text-secondary">Từ khóa hot:</span>
                    <a href="@Url.Action("Index", "Job", new { keyword = ".NET" })" class="badge bg-light text-secondary border text-decoration-none py-1 px-2">ASP.NET MVC</a>
                    <a href="@Url.Action("Index", "Job", new { keyword = "React" })" class="badge bg-light text-secondary border text-decoration-none py-1 px-2">Frontend</a>
                    <a href="@Url.Action("Index", "Job", new { keyword = "Java" })" class="badge bg-light text-secondary border text-decoration-none py-1 px-2">Java Backend</a>
                    <a href="@Url.Action("Index", "Job", new { keyword = "SQL" })" class="badge bg-light text-secondary border text-decoration-none py-1 px-2">Database</a>
                </div>
            </div>
        </div>

        <!-- HERO RIGHT: BENTO STATS & HIGHLIGHTS -->
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-12">
                    <div class="bento-card p-4 bg-primary text-white border-0 shadow">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-white text-primary fw-bold px-3 py-1 rounded-pill">Đang mở tuyển</span>
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <h3 class="display-6 fw-bold mb-1 text-white">1,500+</h3>
                        <p class="mb-0 text-white-50">Vị trí việc làm chất lượng cao được cập nhật mỗi ngày từ các công ty uy tín.</p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bento-card p-3">
                        <div class="text-primary mb-2">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                        </div>
                        <h4 class="fw-bold mb-1">500+</h4>
                        <div class="text-muted small">Doanh nghiệp hàng đầu</div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bento-card p-3">
                        <div class="text-success mb-2">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="8.5" cy="7" r="4"></circle>
                                <polyline points="17 11 19 13 23 9"></polyline>
                            </svg>
                        </div>
                        <h4 class="fw-bold mb-1">98%</h4>
                        <div class="text-muted small">Tỷ lệ hài lòng</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BENTO GRID: RECRUITMENT ECOSYSTEM -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="h3 fw-bold mb-1">Hệ sinh thái tuyển dụng RecruitHub</h2>
                <p class="text-muted mb-0">Giải pháp toàn diện đáp ứng trọn vẹn cả nhu cầu ứng viên lẫn nhà tuyển dụng</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Bento Box 1: Ứng viên -->
            <div class="col-md-6">
                <div class="bento-card h-100 p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div>
                            <h4 class="h5 fw-bold mb-1">Dành Cho Ứng Viên</h4>
                            <p class="text-muted small mb-0">Bứt phá nấc thang sự nghiệp của chính bạn</p>
                        </div>
                    </div>
                    <ul class="list-unstyled text-secondary small mb-4">
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <svg class="text-primary flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Tạo và lưu trữ hồ sơ CV trực tuyến chuyên nghiệp.
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <svg class="text-primary flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Theo dõi trạng thái duyệt hồ sơ & phỏng vấn minh bạch.
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <svg class="text-primary flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Lưu việc làm yêu thích để nộp nhanh khi sẵn sàng.
                        </li>
                    </ul>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary btn-sm">
                        Đăng ký tài khoản ứng viên &raquo;
                    </a>
                </div>
            </div>

            <!-- Bento Box 2: Nhà tuyển dụng -->
            <div class="col-md-6">
                <div class="bento-card h-100 p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="h5 fw-bold mb-1">Dành Cho Nhà Tuyển Dụng</h4>
                            <p class="text-muted small mb-0">Tiếp cận nhân tài chất lượng nhanh chóng</p>
                        </div>
                    </div>
                    <ul class="list-unstyled text-secondary small mb-4">
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <svg class="text-success flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Đăng tin tuyển dụng không giới hạn vị trí và danh mục.
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <svg class="text-success flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Quản lý hồ sơ ứng viên ứng tuyển theo luồng chuyên nghiệp.
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <svg class="text-success flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Quảng bá thương hiệu nhà tuyển dụng đến cộng đồng.
                        </li>
                    </ul>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-outline-secondary btn-sm">
                        Đăng ký tài khoản doanh nghiệp &raquo;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>