@{
    ViewBag.Title = "Truy cập bị từ chối";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/auth/auth.css" />
}

<div class="access-denied-wrapper">
    <div class="access-denied-card">
        <span class="access-denied-badge">HTTP 403 FORBIDDEN</span>

        <div class="access-denied-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>

        <h1 class="access-denied-title">Bạn không có quyền truy cập trang này</h1>

        <p class="access-denied-desc">
            Rất tiếc! Tài khoản hoặc vai trò hiện tại của bạn không được cấp phép để xem nội dung hoặc thực hiện hành động trên trang này.
            Nếu bạn cho rằng đây là sự nhầm lẫn, vui lòng liên hệ quản trị viên hoặc đăng nhập lại bằng tài khoản phù hợp.
        </p>

        <div class="access-denied-actions">
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <svg class="me-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Quay về trang chủ
            </a>
            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary">
                <svg class="me-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                Đăng nhập tài khoản khác
            </a>
        </div>
    </div>
</div>
