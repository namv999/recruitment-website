@{
    ViewBag.Title = "Liên hệ với chúng tôi";
}

<div class="container py-3">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="bento-card h-100 p-4 p-md-5">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-semibold mb-3">Hỗ trợ 24/7</span>
                <h1 class="h2 fw-bold mb-3">Liên hệ ban quản trị</h1>
                <p class="text-muted mb-4">
                    Nếu bạn có bất kỳ thắc mắc nào về việc đăng tin, tạo hồ sơ hoặc cần hợp tác doanh nghiệp, xin vui lòng gửi thông tin cho chúng tôi.
                </p>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-light p-3 text-primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <div>
                        <div class="text-muted small">Điện thoại hotline</div>
                        <div class="fw-bold">1900 8888 (Miễn phí)</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-light p-3 text-primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </div>
                    <div>
                        <div class="text-muted small">Hộp thư hỗ trợ</div>
                        <div class="fw-bold">support@recruithub.vn</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-light p-3 text-primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div>
                        <div class="text-muted small">Địa chỉ văn phòng</div>
                        <div class="fw-bold">Khu Công nghệ cao, TP. Hồ Chí Minh</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="bento-card h-100 p-4 p-md-5">
                <h3 class="h4 fw-bold mb-3">Gửi tin nhắn phản hồi</h3>
                <form onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã liên hệ! Chúng tôi sẽ phản hồi sớm nhất.');">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên</label>
                        <input type="text" class="form-control" placeholder="Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ Email</label>
                        <input type="email" class="form-control" placeholder="name@example.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung tin nhắn</label>
                        <textarea class="form-control" rows="4" placeholder="Nhập nội dung cần hỗ trợ..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Gửi tin nhắn liên hệ
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>