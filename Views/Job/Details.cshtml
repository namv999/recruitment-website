@model recruitment_website.Models.Job.JobDetailViewModel
@{
    ViewBag.Title = Model.Title;
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/job/job.css" />
}

<div class="container py-2">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Job")">Việc làm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    @if (!Model.IsPublished)
    {
        <div class="alert alert-warning" role="status">
            Tin này đang ở trạng thái <strong>@Model.StatusLabel</strong> và chưa hiển thị công khai.
        </div>
    }

    <!-- TIÊU ĐỀ -->
    <div class="bento-card p-4 mb-4">
        <div class="d-flex flex-wrap align-items-start gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyLogoUrl))
            {
                <img class="job-company-logo job-company-logo-lg" src="@Model.CompanyLogoUrl" alt="Logo @Model.CompanyName" />
            }
            else
            {
                <div class="job-company-logo job-company-logo-lg job-company-logo-initial" aria-hidden="true">@Model.CompanyInitial</div>
            }

            <div class="flex-grow-1">
                <h1 class="h3 fw-bold mb-1">@Model.Title</h1>
                <div class="text-secondary mb-2">@Model.CompanyName</div>
                <div class="job-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.City))
                    {
                        <span class="job-meta-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            @Model.City
                        </span>
                    }
                    <span class="job-meta-item">@Model.EmploymentTypeLabel &middot; @Model.LevelLabel &middot; @Model.WorkModeLabel</span>
                    @if (!string.IsNullOrEmpty(Model.PostedAgo))
                    {
                        <span class="job-meta-item">Đăng @Model.PostedAgo.ToLower()</span>
                    }
                </div>
            </div>

            <div class="text-end">
                <div class="job-salary-tag mb-2">@Model.SalaryText</div>
                @if (Model.IsOwner)
                {
                    <div class="d-flex gap-2 justify-content-end">
                        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("MyJobs", "Job")">Quản lý tin</a>
                        <a class="btn btn-primary btn-sm" href="@Url.Action("Edit", "Job", new { id = Model.Id })">Sửa tin</a>
                    </div>
                }
                @* TODO (module C): nút "Ứng tuyển" và "Lưu tin" đặt ở đây, hiển thị cho role candidate *@
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- NỘI DUNG -->
        <div class="col-lg-8">
            <div class="bento-card p-4 mb-4">
                <h2 class="job-section-title">Mô tả công việc</h2>
                <p class="job-text-block">@Model.Description</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Requirements))
            {
                <div class="bento-card p-4 mb-4">
                    <h2 class="job-section-title">Yêu cầu ứng viên</h2>
                    <p class="job-text-block">@Model.Requirements</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Benefits))
            {
                <div class="bento-card p-4 mb-4">
                    <h2 class="job-section-title">Quyền lợi</h2>
                    <p class="job-text-block">@Model.Benefits</p>
                </div>
            }

            @if (Model.Skills.Count > 0)
            {
                <div class="bento-card p-4 mb-4">
                    <h2 class="job-section-title">Kỹ năng</h2>
                    @if (Model.RequiredSkills.Any())
                    {
                        <div class="job-skill-group-label">Bắt buộc</div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var s in Model.RequiredSkills)
                            {
                                <span class="job-skill-pill job-skill-pill-required">@s.Name</span>
                            }
                        </div>
                    }
                    @if (Model.OptionalSkills.Any())
                    {
                        <div class="job-skill-group-label">Ưu tiên / Có thì tốt</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var s in Model.OptionalSkills)
                            {
                                <span class="job-skill-pill" title="@s.ImportanceLabel">@s.Name</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- THÔNG TIN BÊN PHẢI -->
        <aside class="col-lg-4">
            <div class="bento-card p-4 mb-4">
                <h2 class="job-section-title">Tổng quan</h2>
                <dl class="job-overview-list">
                    <div class="job-overview-row"><dt>Mức lương</dt><dd>@Model.SalaryText@(Model.SalaryNegotiable ? " (thương lượng)" : "")</dd></div>
                    <div class="job-overview-row"><dt>Cấp bậc</dt><dd>@Model.LevelLabel</dd></div>
                    <div class="job-overview-row"><dt>Hình thức</dt><dd>@Model.EmploymentTypeLabel</dd></div>
                    <div class="job-overview-row"><dt>Nơi làm việc</dt><dd>@Model.WorkModeLabel</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <div class="job-overview-row"><dt>Địa chỉ</dt><dd>@Model.Address</dd></div>
                    }
                    <div class="job-overview-row"><dt>Kinh nghiệm</dt><dd>@Model.MinExperienceText</dd></div>
                    <div class="job-overview-row"><dt>Học vấn</dt><dd>@Model.MinEducationLabel</dd></div>
                    <div class="job-overview-row"><dt>Số lượng</dt><dd>@Model.Headcount người</dd></div>
                    @if (Model.ExpiresAt.HasValue)
                    {
                        <div class="job-overview-row"><dt>Hạn nộp</dt><dd>@Model.ExpiresAt.Value.ToString("dd/MM/yyyy")</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                    {
                        <div class="job-overview-row"><dt>Ngành nghề</dt><dd>@Model.CategoryName</dd></div>
                    }
                    @if (Model.IsOwner)
                    {
                        <div class="job-overview-row"><dt>Trạng thái</dt><dd><span class="job-status-badge @("job-status-" + Model.Status)">@Model.StatusLabel</span></dd></div>
                        <div class="job-overview-row"><dt>Lượt xem</dt><dd>@Model.ViewCount</dd></div>
                    }
                </dl>
            </div>

            <div class="bento-card p-4">
                <h2 class="job-section-title">Về công ty</h2>
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyLogoUrl))
                    {
                        <img class="job-company-logo" src="@Model.CompanyLogoUrl" alt="" />
                    }
                    else
                    {
                        <div class="job-company-logo job-company-logo-initial" aria-hidden="true">@Model.CompanyInitial</div>
                    }
                    <div>
                        <div class="fw-bold">@Model.CompanyName</div>
                        @if (Model.CompanyIsVerified)
                        {
                            <span class="job-verified">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                Đã xác minh
                            </span>
                        }
                    </div>
                </div>
                <dl class="job-overview-list">
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyIndustry))
                    {
                        <div class="job-overview-row"><dt>Lĩnh vực</dt><dd>@Model.CompanyIndustry</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CompanySize))
                    {
                        <div class="job-overview-row"><dt>Quy mô</dt><dd>@Model.CompanySize nhân viên</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyCity))
                    {
                        <div class="job-overview-row"><dt>Địa điểm</dt><dd>@Model.CompanyCity</dd></div>
                    }
                    @if (Model.CompanyWebsiteUrl != null)
                    {
                        <div class="job-overview-row"><dt>Website</dt><dd><a href="@Model.CompanyWebsiteUrl" target="_blank" rel="noopener noreferrer">Truy cập</a></dd></div>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                {
                    <p class="job-text-block small mt-3">@Model.CompanyDescription</p>
                }
            </div>
        </aside>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/job/job.js"></script>
}
