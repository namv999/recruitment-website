@model recruitment_website.Models.Job.JobFormViewModel
@* Các trường chung của form Đăng tin / Sửa tin. Đặt BÊN TRONG thẻ <form> của View cha. *@

<div class="bento-card p-4 mb-4">
    <h2 class="job-section-title">Thông tin chung</h2>

    <div class="mb-3">
        @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold text-secondary" })
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", maxlength = 255, placeholder = "VD: Lập trình viên ASP.NET MVC" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small mt-1 d-block" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.CategoryId, new { @class = "form-label fw-semibold text-secondary" })
        @Html.DropDownListFor(m => m.CategoryId, Model.CategoryOptions, "-- Chọn ngành nghề --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small mt-1 d-block" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold text-secondary" })
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 8 })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small mt-1 d-block" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Requirements, new { @class = "form-label fw-semibold text-secondary" })
        @Html.TextAreaFor(m => m.Requirements, new { @class = "form-control", rows = 6 })
        @Html.ValidationMessageFor(m => m.Requirements, "", new { @class = "text-danger small mt-1 d-block" })
    </div>

    <div>
        @Html.LabelFor(m => m.Benefits, new { @class = "form-label fw-semibold text-secondary" })
        @Html.TextAreaFor(m => m.Benefits, new { @class = "form-control", rows = 5 })
        @Html.ValidationMessageFor(m => m.Benefits, "", new { @class = "text-danger small mt-1 d-block" })
    </div>
</div>

<div class="bento-card p-4 mb-4">
    <h2 class="job-section-title">Điều kiện làm việc</h2>

    <div class="row g-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.EmploymentType, new { @class = "form-label fw-semibold text-secondary" })
            @Html.DropDownListFor(m => m.EmploymentType, Model.EmploymentTypeOptions, new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.EmploymentType, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Level, new { @class = "form-label fw-semibold text-secondary" })
            @Html.DropDownListFor(m => m.Level, Model.LevelOptions, new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Level, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.WorkMode, new { @class = "form-label fw-semibold text-secondary" })
            @Html.DropDownListFor(m => m.WorkMode, Model.WorkModeOptions, new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.WorkMode, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.City, new { @class = "form-label fw-semibold text-secondary" })
            @Html.TextBoxFor(m => m.City, new { @class = "form-control", maxlength = 100, placeholder = "VD: TP.HCM" })
            @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-8">
            @Html.LabelFor(m => m.Address, new { @class = "form-label fw-semibold text-secondary" })
            @Html.TextBoxFor(m => m.Address, new { @class = "form-control", maxlength = 500 })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="col-md-3">
            @Html.LabelFor(m => m.MinExperienceYears, new { @class = "form-label fw-semibold text-secondary" })
            @Html.TextBoxFor(m => m.MinExperienceYears, new { @class = "form-control", type = "number", min = 0, max = 50, step = "0.5" })
            @Html.ValidationMessageFor(m => m.MinExperienceYears, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.MinEducation, new { @class = "form-label fw-semibold text-secondary" })
            @Html.DropDownListFor(m => m.MinEducation, Model.EducationOptions, "Không yêu cầu", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.MinEducation, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.Headcount, new { @class = "form-label fw-semibold text-secondary" })
            @Html.TextBoxFor(m => m.Headcount, new { @class = "form-control", type = "number", min = 1, max = 10000 })
            @Html.ValidationMessageFor(m => m.Headcount, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-3">
            @* Ô hiển thị dd/mm/yyyy (người dùng nhập). Giá trị gửi lên server là ô ẩn ExpiresAt dạng yyyy-MM-dd (xử lý trong job.js). *@
            <label for="ExpiresAtDisplay" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(m => m.ExpiresAt)</label>
            <input type="text" id="ExpiresAtDisplay" class="form-control" inputmode="numeric" maxlength="10"
                   placeholder="dd/mm/yyyy" autocomplete="off"
                   value="@(Model.ExpiresAt.HasValue ? Model.ExpiresAt.Value.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) : "")"
                   data-date-input data-date-target="ExpiresAt" />
            <input type="hidden" id="ExpiresAt" name="ExpiresAt"
                   value="@(Model.ExpiresAt.HasValue ? Model.ExpiresAt.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "")" />
            <span class="text-danger small mt-1 d-block" data-date-error hidden></span>
            @Html.ValidationMessageFor(m => m.ExpiresAt, "", new { @class = "text-danger small mt-1 d-block" })
            <div class="job-form-hint mt-1">VD: 31/12/2026. Để trống nếu không giới hạn.</div>
        </div>
    </div>
</div>

<div class="bento-card p-4 mb-4">
    <h2 class="job-section-title">Mức lương</h2>

    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            @Html.LabelFor(m => m.SalaryMin, new { @class = "form-label fw-semibold text-secondary" })
            @Html.TextBoxFor(m => m.SalaryMin, new { @class = "form-control", type = "number", min = 0, step = 500000 })
            @Html.ValidationMessageFor(m => m.SalaryMin, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.SalaryMax, new { @class = "form-label fw-semibold text-secondary" })
            @Html.TextBoxFor(m => m.SalaryMax, new { @class = "form-control", type = "number", min = 0, step = 500000 })
            @Html.ValidationMessageFor(m => m.SalaryMax, "", new { @class = "text-danger small mt-1 d-block" })
        </div>
        <div class="col-md-4">
            <div class="form-check mb-2">
                @Html.CheckBoxFor(m => m.SalaryNegotiable, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.SalaryNegotiable, new { @class = "form-check-label" })
            </div>
        </div>
    </div>
    <p class="job-form-hint mt-2 mb-0">Để trống cả hai ô lương nếu muốn hiển thị "Thỏa thuận".</p>
</div>

<div class="bento-card p-4 mb-4">
    <h2 class="job-section-title">Kỹ năng yêu cầu</h2>
    @Html.Partial("_SkillSelector", Model.SkillSelector)
    @Html.ValidationMessageFor(m => m.SelectedSkillIds, "", new { @class = "text-danger small mt-1 d-block" })
</div>
