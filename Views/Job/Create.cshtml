@model recruitment_website.Models.Job.JobCreateViewModel
@{
    ViewBag.Title = "Đăng tin tuyển dụng";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/shared/skill-selector.css?v=2" />
    <link rel="stylesheet" href="~/Content/css/job/job.css?v=2" />
}

<div class="container py-2">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("MyJobs", "Job")">Quản lý tin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đăng tin mới</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Đăng tin tuyển dụng</h1>
        <p class="text-muted mb-0">Tin sẽ hiển thị công khai sau khi Admin duyệt.</p>
    </div>

    @using (Html.BeginForm("Create", "Job", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        @Html.Partial("_JobForm", Model)

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a class="btn btn-outline-secondary" href="@Url.Action("MyJobs", "Job")">Hủy</a>
            <button type="submit" class="btn btn-primary">Gửi tin để duyệt</button>
        </div>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/shared/skill-selector.js?v=2"></script>
    <script src="~/Scripts/job/job.js?v=2"></script>
}
