@model recruitment_website.Models.Candidate.CandidateEditViewModel

@{
    ViewBag.Title = "Chỉnh sửa thông tin cá nhân";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/candidate/candidate.css" />
}

<div class="container my-4 candidate-edit-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Chỉnh sửa hồ sơ cá nhân</h3>
        <a href="@Url.Action("Profile", "Candidate")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @using (Html.BeginForm("Edit", "Candidate", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <!-- Thẻ 1: Thông tin cá nhân -->
        <div class="card p-4 mb-4 shadow-sm bento-card">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin cá nhân</h5>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nhập họ và tên" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "0xxxxxxxxx hoặc +84xxxxxxxxx" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">Ngày sinh</label>
                    @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">Giới tính</label>
                    @Html.DropDownListFor(m => m.Gender, Model.GenderOptions, "-- Chọn --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">Tỉnh / Thành phố</label>
                    @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "Nhập Tỉnh/Thành phố" })
                    @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
            </div>
        </div>

        <!-- Thẻ 2: Nghề nghiệp -->
        <div class="card p-4 mb-4 shadow-sm bento-card">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin nghề nghiệp</h5>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold">Chức danh / Tiêu đề hồ sơ</label>
                    @Html.TextBoxFor(m => m.Headline, new { @class = "form-control", placeholder = "Ví dụ: Senior .NET Developer" })
                    @Html.ValidationMessageFor(m => m.Headline, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold">Trình độ học vấn cao nhất</label>
                    @Html.DropDownListFor(m => m.HighestEducation, Model.EducationOptions, "-- Chọn --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.HighestEducation, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold">Mức lương mong muốn (VNĐ)</label>
                    @Html.TextBoxFor(m => m.ExpectedSalary, new { @class = "form-control", type = "number", placeholder = "Ví dụ: 15000000" })
                    @Html.ValidationMessageFor(m => m.ExpectedSalary, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-12 col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        @Html.CheckBoxFor(m => m.OpenToWork, new { @class = "form-check-input", id = "OpenToWorkCheck" })
                        <label class="form-check-label fw-semibold" for="OpenToWorkCheck">
                            Đang bật trạng thái sẵn sàng tìm việc (Open To Work)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Giới thiệu bản thân -->
        <div class="card p-4 mb-4 shadow-sm bento-card">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Giới thiệu bản thân</h5>
            <div class="mb-3">
                <label class="form-label fw-semibold">Tóm tắt tiểu sử & mục tiêu nghề nghiệp</label>
                @Html.TextAreaFor(m => m.Summary, new { @class = "form-control", rows = "5", placeholder = "Nhập đôi dòng giới thiệu bản thân..." })
                @Html.ValidationMessageFor(m => m.Summary, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        </div>

        <!-- Nút Action -->
        <div class="d-flex justify-content-end gap-2">
            <a href="@Url.Action("Profile", "Candidate")" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
        </div>
    }
</div>

@section scripts {
    <script src="~/Scripts/candidate/candidate.js"></script>
}