@model recruitment_website.Models.Candidate.CvListViewModel

@{
    ViewBag.Title = "Quản lý CV";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/candidate/candidate.css" />
}

<div class="container my-4 candidate-cvs-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Quản lý CV của tôi</h3>
            <p class="text-muted small mb-0">Tải lên và quản lý các CV để dễ dàng ứng tuyển việc làm.</p>
        </div>
        <a href="@Url.Action("Profile", "Candidate")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Về Hồ sơ
        </a>
    </div>

    <div class="row g-4">
        <!-- Cột Tải lên CV -->
        <div class="col-12 col-lg-4">
            <div class="card p-4 shadow-sm bento-card">
                <h5 class="fw-bold mb-3"><i class="bi bi-cloud-upload me-2"></i>Tải lên CV mới</h5>

                @using (Html.BeginForm("UploadCv", "Candidate", FormMethod.Post, new { enctype = "multipart/form-data", id = "cvUploadForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">Tên gợi nhớ CV</label>
                        <input type="text" name="Title" class="form-control" maxlength="150" placeholder="Ví dụ: CV Backend .NET" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">Chọn tệp CV</label>
                        <input type="file" name="file" id="cvFileInput" class="form-control" accept=".pdf,.doc,.docx" required />
                        <span id="cvFileError" class="text-danger small mt-1 d-block"></span>
                        <span class="form-text extra-small d-block mt-1 text-muted">
                            Định dạng hỗ trợ: .pdf, .doc, .docx. Dung lượng tối đa: 3 MB.
                        </span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="btnUploadCv">
                        <i class="bi bi-upload"></i> Tải lên CV
                    </button>
                }
            </div>
        </div>

        <!-- Cột Danh sách CV -->
        <div class="col-12 col-lg-8">
            <div class="card p-4 shadow-sm bento-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-files me-2 text-primary"></i>Danh sách CV đã tải</h5>
                    @if (Model != null && Model.Cvs != null && Model.Cvs.Any())
                    {
                        <span class="text-muted extra-small d-none d-sm-inline">
                            <i class="bi bi-info-circle me-1"></i>Nháy đúp hàng để xem nhanh chi tiết
                        </span>
                    }
                </div>

                @if (Model != null && Model.Cvs != null && Model.Cvs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên CV</th>
                                    <th>Định dạng</th>
                                    <th>Ngày tải</th>
                                    <th class="text-end" style="min-width: 160px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cv in Model.Cvs)
                                {
                                    <tr class="cv-table-row"
                                        data-id="@cv.Id"
                                        data-title="@cv.Title"
                                        data-filetype="@cv.FileType"
                                        data-filesize="@cv.FileSizeFormatted"
                                        data-uploaded="@cv.UploadedAt.ToString("dd/MM/yyyy HH:mm")"
                                        data-isdefault="@(cv.IsDefault ? "true" : "false")"
                                        data-appcount="@cv.ApplicationsCount"
                                        data-preview-url="@cv.PreviewUrl"
                                        data-download-url="@cv.DownloadUrl"
                                        title="Nháy đúp để xem chi tiết CV">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="fs-4 text-secondary">
                                                    @if (cv.FileType == "PDF")
                                                    {
                                                        <i class="bi bi-file-earmark-pdf text-danger"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-earmark-word text-primary"></i>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@cv.Title</div>
                                                    @if (cv.IsDefault)
                                                    {
                                                        <span class="badge bg-success small"><i class="bi bi-check-circle me-1"></i>Mặc định</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@cv.FileType</span>
                                        </td>
                                        <td class="small text-muted">
                                            <div>@cv.UploadedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            <div class="extra-small text-secondary">@cv.FileSizeFormatted</div>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1 cv-action-group">
                                                <!-- Link/Nút Xem chi tiết -->
                                                <button type="button" class="btn btn-sm btn-outline-primary cv-action-btn btn-preview-cv"
                                                        title="Xem chi tiết & Preview" data-bs-toggle="tooltip">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                <!-- Link Download -->
                                                <a href="@cv.DownloadUrl" class="btn btn-sm btn-outline-secondary cv-action-btn"
                                                   title="Tải về" data-bs-toggle="tooltip">
                                                    <i class="bi bi-download"></i>
                                                </a>

                                                <!-- Form Đặt mặc định -->
                                                @if (!cv.IsDefault)
                                                {
                                                    <form action="@Url.Action("SetDefaultCv", "Candidate")" method="post" class="d-inline m-0 p-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@cv.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success cv-action-btn"
                                                                title="Đặt mặc định" data-bs-toggle="tooltip">
                                                            <i class="bi bi-star"></i>
                                                        </button>
                                                    </form>
                                                }

                                                <!-- Form Xóa -->
                                                <form action="@Url.Action("DeleteCv", "Candidate")" method="post" class="d-inline m-0 p-0"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa CV này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@cv.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger cv-action-btn"
                                                            title="Xóa CV" data-bs-toggle="tooltip">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-5 candidate-empty-state">
                        <div class="display-5 text-muted mb-3"><i class="bi bi-file-earmark-x"></i></div>
                        <h6 class="text-muted fw-normal">Bạn chưa tải lên CV nào.</h6>
                        <p class="text-muted extra-small">Hãy tải lên CV đầu tiên ở khung bên cạnh để ứng tuyển nhanh chóng.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem chi tiết & Preview CV -->
<div class="modal fade" id="cvDetailModal" tabindex="-1" aria-labelledby="cvDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div id="modalCvIcon" class="fs-4">
                        <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="cvDetailModalLabel">Chi tiết CV</h5>
                        <span id="modalCvDefaultBadge" class="badge bg-success small mt-1 d-none">
                            <i class="bi bi-check-circle me-1"></i>CV mặc định
                        </span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Bento Info Box -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="cv-meta-box">
                            <div class="cv-meta-label">Định dạng tệp</div>
                            <div class="cv-meta-value text-primary" id="modalCvFileType">PDF</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="cv-meta-box">
                            <div class="cv-meta-label">Dung lượng</div>
                            <div class="cv-meta-value" id="modalCvFileSize">--</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="cv-meta-box">
                            <div class="cv-meta-label">Ngày tải lên</div>
                            <div class="cv-meta-value" id="modalCvUploadedAt">--</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="cv-meta-box">
                            <div class="cv-meta-label">Lượt ứng tuyển</div>
                            <div class="cv-meta-value text-success" id="modalCvAppCount">0 việc làm</div>
                        </div>
                    </div>
                </div>

                <!-- Preview Frame Section -->
                <div class="cv-preview-container position-relative">
                    <!-- Loading Spinner -->
                    <div id="modalCvLoading" class="position-absolute top-50 start-50 translate-middle text-center py-5">
                        <div class="spinner-border text-primary mb-2" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <div class="small text-muted">Đang chuẩn bị tài liệu xem trước...</div>
                    </div>

                    <!-- PDF iFrame -->
                    <iframe id="modalCvIframe" class="cv-preview-iframe d-none" title="Xem trước CV"></iframe>

                    <!-- Non-PDF Notice (Word documents) -->
                    <div id="modalCvNonPdfNotice" class="d-none text-center p-5">
                        <div class="display-4 text-primary mb-3">
                            <i class="bi bi-file-earmark-word"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Tài liệu định dạng Word</h5>
                        <p class="text-muted small mb-4" style="max-width: 520px; margin: 0 auto;">
                            Định dạng Word (.doc, .docx) không thể xem trực tiếp trực tuyến an toàn mà không qua dịch vụ bên thứ ba. Bạn có thể tải tệp về thiết bị để xem toàn bộ nội dung.
                        </p>
                        <a id="modalWordDownloadBtn" href="#" class="btn btn-primary">
                            <i class="bi bi-download me-1"></i> Tải tệp Word về máy
                        </a>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top bg-light py-2">
                <div class="d-flex justify-content-between w-100 align-items-center flex-wrap gap-2">
                    <div class="small text-muted">
                        <i class="bi bi-shield-check me-1"></i>Tài liệu được bảo vệ trong hệ thống RecruitHub
                    </div>
                    <div class="d-flex gap-2">
                        <a id="modalOpenTabBtn" href="#" target="_blank" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Mở tab mới
                        </a>
                        <a id="modalDownloadBtn" href="#" class="btn btn-primary btn-sm">
                            <i class="bi bi-download me-1"></i> Tải về máy
                        </a>
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/candidate/cv-upload.js"></script>
}