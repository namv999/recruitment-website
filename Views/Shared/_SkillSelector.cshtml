@model recruitment_website.Models.Shared.SkillSelectorViewModel
@*
    ================================================================
    _SkillSelector — chọn nhiều kỹ năng (dùng chung Job + Candidate)
    ================================================================
    Model : SkillSelectorViewModel (Options, SelectedIds, FieldName)
    Gửi về: các checkbox cùng name = Model.FieldName, giá trị là skill id
            -> bind thẳng vào List<int> (vd JobCreateViewModel.SelectedSkillIds).

    Cách dùng trong View cha:

        @Html.Partial("_SkillSelector", Model.SkillSelector)
        @Html.ValidationMessageFor(m => m.SelectedSkillIds, "", new { @class = "text-danger small mt-1 d-block" })

        @section styles {
            <link rel="stylesheet" href="~/Content/css/shared/skill-selector.css" />
        }
        @section scripts {
            <script src="~/Scripts/shared/skill-selector.js"></script>
        }

    Không có JS vẫn dùng được: danh sách checkbox hiển thị sẵn và gửi form bình thường.
*@
@{
    string panelId = "skillPanel_" + Model.FieldName;
}

<div class="skill-selector" id="skillSelector_@Model.FieldName" data-skill-selector>
    <div class="skill-selector-control">
        <div class="skill-selector-chips" data-skill-chips aria-live="polite"></div>
        <button type="button" class="skill-selector-toggle" data-skill-toggle
                aria-expanded="false" aria-controls="@panelId">
            <span data-skill-toggle-label>Chọn kỹ năng</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </button>
    </div>

    <div class="skill-selector-panel" id="@panelId">
        <div class="skill-selector-search-wrap">
            <input type="search" class="form-control form-control-sm" data-skill-search
                   placeholder="Tìm kỹ năng..." aria-label="Tìm kỹ năng" autocomplete="off" />
        </div>

        <div class="skill-selector-list" data-skill-list>
            @foreach (var group in Model.GroupedOptions)
            {
                <div class="skill-selector-group" data-skill-group>
                    <div class="skill-selector-group-title">@group.Key</div>
                    @foreach (var option in group)
                    {
                        <label class="skill-selector-option" data-skill-option>
                            <input type="checkbox" class="form-check-input"
                                   name="@Model.FieldName" value="@option.Id"
                                   checked="@Model.IsSelected(option.Id)" />
                            <span class="skill-selector-option-name">@option.Name</span>
                        </label>
                    }
                </div>
            }

            <div class="skill-selector-empty" data-skill-empty hidden>Không tìm thấy kỹ năng phù hợp.</div>
        </div>
    </div>
</div>
