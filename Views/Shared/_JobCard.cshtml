@model recruitment_website.Models.Job.JobCardViewModel
@* Thẻ 1 tin tuyển dụng trong danh sách. Model: JobCardViewModel *@
<article class="job-card">
    <div class="d-flex align-items-start gap-3 mb-3">
        @if (!string.IsNullOrWhiteSpace(Model.CompanyLogoUrl))
        {
            <img class="job-company-logo" src="@Model.CompanyLogoUrl" alt="Logo @Model.CompanyName" loading="lazy" />
        }
        else
        {
            <div class="job-company-logo job-company-logo-initial" aria-hidden="true">@Model.CompanyInitial</div>
        }

        <div class="flex-grow-1 min-w-0">
            <h3 class="h5 fw-bold mb-1">
                <a class="job-manage-title" href="@Url.Action("Details", "Job", new { id = Model.Id })">@Model.Title</a>
            </h3>
            <div class="text-secondary mb-2">@Model.CompanyName</div>
            <div class="job-meta">
                @if (!string.IsNullOrWhiteSpace(Model.City))
                {
                    <span class="job-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        @Model.City
                    </span>
                }
                <span class="job-meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    @Model.EmploymentTypeLabel &middot; @Model.LevelLabel
                </span>
                @if (!string.IsNullOrEmpty(Model.PostedAgo))
                {
                    <span class="job-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        @Model.PostedAgo
                    </span>
                }
            </div>
        </div>

        <span class="job-salary-tag">@Model.SalaryText</span>
    </div>

    @if (Model.SkillNames.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var skill in Model.SkillNames)
            {
                <span class="job-skill-pill">@skill</span>
            }
        </div>
    }
</article>
