@model recruitment_website.Models.Application.ApplicationApplyViewModel

@{
    ViewBag.Title = "Ứng tuyển - " + Model.JobTitle;
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/application/application.css" />
}

<div class="container py-2 app-container">
    <div class="mb-3">
        <a href="@Url.Action("Details", "Job", new { id = Model.JobId })" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại chi tiết công việc
        </a>
    </div>

    <div class="row g-4">
        <!-- Tóm tắt tin tuyển dụng (Bento Grid) -->
        <div class="col-12 col-lg-4">
            <div class="card p-4 shadow-sm candidate-card">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin công việc</h5>
                <h6 class="fw-bold text-primary mb-1">@Model.JobTitle</h6>
                <p class="text-muted mb-3"><i class="bi bi-building me-1"></i>@Model.CompanyName</p>
                <div class="alert alert-info small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Vui lòng chọn CV và kiểm tra kỹ thông tin trước khi nộp đơn ứng tuyển.
                </div>
            </div>
        </div>

        <!-- Form Ứng tuyển -->
        <div class="col-12 col-lg-8">
            <div class="card p-4 shadow-sm candidate-card">
                <h4 class="fw-bold mb-4">Nộp đơn ứng tuyển</h4>

                @using (Html.BeginForm("Apply", "Application", FormMethod.Post, new { id = "applyForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.JobId)

                    <!-- Chọn CV -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold candidate-required">Chọn CV ứng tuyển</label>
                        @Html.ValidationMessageFor(m => m.CvId, "", new { @class = "text-danger small mt-1 d-block" })

                        @if (Model.Cvs != null && Model.Cvs.Any())
                        {
                            <div class="d-flex flex-column gap-2 mt-2">
                                @foreach (var cv in Model.Cvs)
                                {
                                    <label class="app-cv-option border rounded p-3 d-flex align-items-center justify-content-between cursor-pointer">
                                        <div class="d-flex align-items-center gap-3">
                                            <input type="radio" name="CvId" value="@cv.Id" class="form-check-input mt-0" @(Model.CvId == cv.Id ? "checked" : "") required />
                                            <div>
                                                <div class="fw-semibold">
                                                    @cv.Title
                                                    @if (cv.IsDefault)
                                                    {
                                                        <span class="badge bg-success ms-1">Mặc định</span>
                                                    }
                                                </div>
                                                <div class="text-muted candidate-extra-small">Tải lên: @cv.UploadedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                        </div>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning small mt-2 mb-0">
                                Bạn chưa có CV nào. Vui lòng <a href="@Url.Action("Cvs", "Candidate")" class="alert-link">Tải lên CV</a> trước khi ứng tuyển.
                            </div>
                        }
                    </div>

                    <!-- Thư giới thiệu -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Thư giới thiệu (Cover Letter)</label>
                        @Html.TextAreaFor(m => m.CoverLetter, new { @class = "form-control", rows = 6, maxlength = 2000, id = "coverLetterInput", placeholder = "Viết ngắn gọn lý do bạn phù hợp với vị trí này..." })
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            @Html.ValidationMessageFor(m => m.CoverLetter, "", new { @class = "text-danger small d-block" })
                            <span class="text-muted candidate-extra-small ms-auto" id="coverLetterCounter">0 / 2000 ký tự</span>
                        </div>
                    </div>

                    <!-- Nút Thao tác -->
                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="@Url.Action("Details", "Job", new { id = Model.JobId })" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4" id="applySubmitBtn" @(Model.Cvs == null || !Model.Cvs.Any() ? "disabled" : "")>
                            Gửi đơn ứng tuyển
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/application/application.js"></script>
}