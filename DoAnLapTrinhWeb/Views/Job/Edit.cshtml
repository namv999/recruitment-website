@using DoAnLapTrinhWeb.Models
@model Job
@{
    ViewBag.Title = "Sửa tin: " + Model.Title;
    Layout = "~/Views/Shared/_LayoutTuyenDung.cshtml";
    List<Company> dsCongTy = (List<Company>)ViewBag.DsCongTy;
    List<JobCategory> dsDanhMuc = (List<JobCategory>)ViewBag.DsDanhMuc;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h5 class="section-title">Sửa tin tuyển dụng</h5>

        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger">@TempData["Loi"]</div>
        }

        <div class="bg-white rounded-4 shadow-sm p-4">
            @using (Html.BeginForm("Edit", "Job", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Tên vị trí *</label>
                        <input class="form-control" type="text" name="Title" value="@Model.Title" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Công ty đăng tin *</label>
                        <select class="form-select" name="CompanyId" required>
                            <option value="">-- Chọn công ty --</option>
                            @foreach (Company ct in dsCongTy)
                            {
                                <option value="@ct.Id" selected="@(ct.Id == Model.CompanyId ? "selected" : null)">@ct.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Danh mục nghề</label>
                        <select class="form-select" name="CategoryId">
                            <option value="">-- Không chọn --</option>
                            @foreach (JobCategory dm in dsDanhMuc)
                            {
                                <option value="@dm.Id" selected="@(dm.Id == Model.CategoryId ? "selected" : null)">@dm.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Cấp bậc</label>
                        <select class="form-select" name="Level">
                            <option value="intern" selected="@(Model.Level == "intern" ? "selected" : null)">Thực tập sinh</option>
                            <option value="fresher" selected="@(Model.Level == "fresher" ? "selected" : null)">Fresher</option>
                            <option value="junior" selected="@(Model.Level == "junior" ? "selected" : null)">Junior</option>
                            <option value="middle" selected="@(Model.Level == "middle" ? "selected" : null)">Middle</option>
                            <option value="senior" selected="@(Model.Level == "senior" ? "selected" : null)">Senior</option>
                            <option value="lead" selected="@(Model.Level == "lead" ? "selected" : null)">Lead</option>
                            <option value="manager" selected="@(Model.Level == "manager" ? "selected" : null)">Manager</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Loại hình</label>
                        <select class="form-select" name="EmploymentType">
                            <option value="full_time" selected="@(Model.EmploymentType == "full_time" ? "selected" : null)">Toàn thời gian</option>
                            <option value="part_time" selected="@(Model.EmploymentType == "part_time" ? "selected" : null)">Bán thời gian</option>
                            <option value="internship" selected="@(Model.EmploymentType == "internship" ? "selected" : null)">Thực tập</option>
                            <option value="contract" selected="@(Model.EmploymentType == "contract" ? "selected" : null)">Hợp đồng</option>
                            <option value="freelance" selected="@(Model.EmploymentType == "freelance" ? "selected" : null)">Freelance</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hình thức làm việc</label>
                        <select class="form-select" name="WorkMode">
                            <option value="onsite" selected="@(Model.WorkMode == "onsite" ? "selected" : null)">Tại văn phòng</option>
                            <option value="remote" selected="@(Model.WorkMode == "remote" ? "selected" : null)">Từ xa</option>
                            <option value="hybrid" selected="@(Model.WorkMode == "hybrid" ? "selected" : null)">Kết hợp</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Thành phố</label>
                        <input class="form-control" type="text" name="City" value="@Model.City" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Số lượng cần tuyển</label>
                        <input class="form-control" type="number" min="1" name="Headcount" value="@Model.Headcount" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Địa chỉ làm việc</label>
                        <input class="form-control" type="text" name="Address" value="@Model.Address" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Trạng thái tin</label>
                        <select class="form-select" name="Status">
                            <option value="draft" selected="@(Model.Status == "draft" ? "selected" : null)">Nháp</option>
                            <option value="pending" selected="@(Model.Status == "pending" ? "selected" : null)">Chờ duyệt</option>
                            <option value="published" selected="@(Model.Status == "published" ? "selected" : null)">Đang đăng</option>
                            <option value="paused" selected="@(Model.Status == "paused" ? "selected" : null)">Tạm dừng</option>
                            <option value="closed" selected="@(Model.Status == "closed" ? "selected" : null)">Đã đóng</option>
                            <option value="expired" selected="@(Model.Status == "expired" ? "selected" : null)">Hết hạn</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Lương tối thiểu</label>
                        <input class="form-control" type="number" name="SalaryMin" value="@Model.SalaryMin" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Lương tối đa</label>
                        <input class="form-control" type="number" name="SalaryMax" value="@Model.SalaryMax" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Đơn vị tiền</label>
                        <input class="form-control" type="text" name="Currency" value="@Model.Currency" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" name="SalaryNegotiable" value="true" id="chkThoaThuan" checked="@(Model.SalaryNegotiable ? "checked" : null)" />
                            <label class="form-check-label" for="chkThoaThuan">Lương thoả thuận</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Kinh nghiệm tối thiểu (năm)</label>
                        <input class="form-control" type="number" step="0.5" min="0" name="MinExperienceYears" value="@Model.MinExperienceYears" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Học vấn tối thiểu</label>
                        <select class="form-select" name="MinEducation">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.MinEducation) ? "selected" : null)">-- Không yêu cầu --</option>
                            <option value="high_school" selected="@(Model.MinEducation == "high_school" ? "selected" : null)">THPT</option>
                            <option value="college" selected="@(Model.MinEducation == "college" ? "selected" : null)">Cao đẳng</option>
                            <option value="bachelor" selected="@(Model.MinEducation == "bachelor" ? "selected" : null)">Đại học</option>
                            <option value="master" selected="@(Model.MinEducation == "master" ? "selected" : null)">Thạc sĩ</option>
                            <option value="phd" selected="@(Model.MinEducation == "phd" ? "selected" : null)">Tiến sĩ</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Mô tả công việc</label>
                        <textarea class="form-control" name="Description" rows="4">@Model.Description</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Yêu cầu ứng viên</label>
                        <textarea class="form-control" name="Requirements" rows="3">@Model.Requirements</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Quyền lợi</label>
                        <textarea class="form-control" name="Benefits" rows="3">@Model.Benefits</textarea>
                    </div>
                </div>

                <button class="btn btn-accent mt-4 px-4" type="submit"><i class="fa-solid fa-check me-1"></i>Lưu thay đổi</button>
                <a class="btn btn-outline-secondary mt-4 px-4" href="@Url.Action("Details", new { id = Model.Id })">Huỷ</a>
            }
        </div>
    </div>
</div>
