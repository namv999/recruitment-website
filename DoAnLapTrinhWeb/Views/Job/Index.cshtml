@using DoAnLapTrinhWeb.Models
@model List<Job>
@{
    ViewBag.Title = "Quản lý tin tuyển dụng";
    Layout = "~/Views/Shared/_LayoutTuyenDung.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="section-title mb-0">Quản lý tin tuyển dụng (@Model.Count)</h5>
    <a class="btn btn-accent" href="@Url.Action("Create")"><i class="fa-solid fa-plus me-1"></i>Đăng tin mới</a>
</div>

<div class="bg-white rounded-4 shadow-sm p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>Vị trí</th>
                    <th>Công ty</th>
                    <th>Thành phố</th>
                    <th>Cấp bậc</th>
                    <th>Trạng thái</th>
                    <th>Ngày đăng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Job j in Model)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold text-decoration-none" href="@Url.Action("Details", new { id = j.Id })">@j.Title</a>
                        </td>
                        <td>@j.CompanyName</td>
                        <td>@j.City</td>
                        <td>@j.Level</td>
                        <td><span class="badge bg-light text-dark border">@j.Status</span></td>
                        <td class="small text-muted">@String.Format("{0:dd/MM/yyyy}", j.PublishedAt)</td>
                        <td class="text-end">
                            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Edit", new { id = j.Id })" title="Sửa">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Delete", new { id = j.Id })" title="Xoá">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center my-3 mb-0">Chưa có tin tuyển dụng nào. Bấm "Đăng tin mới" để bắt đầu.</p>
        }
    </div>
</div>
