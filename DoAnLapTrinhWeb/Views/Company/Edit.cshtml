@using DoAnLapTrinhWeb.Models
@model Company
@{
    ViewBag.Title = "Sửa thông tin: " + Model.Name;
    Layout = "~/Views/Shared/_LayoutTuyenDung.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h5 class="section-title">Sửa thông tin công ty</h5>

        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger">@TempData["Loi"]</div>
        }

        <div class="bg-white rounded-4 shadow-sm p-4">
            @using (Html.BeginForm("Edit", "Company", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Tên công ty *</label>
                        <input class="form-control" type="text" name="Name" value="@Model.Name" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mã số thuế</label>
                        <input class="form-control" type="text" name="TaxCode" value="@Model.TaxCode" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Logo (URL hình ảnh)</label>
                        <input class="form-control" type="text" name="LogoUrl" value="@Model.LogoUrl" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Website</label>
                        <input class="form-control" type="text" name="Website" value="@Model.Website" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Ngành nghề</label>
                        <input class="form-control" type="text" name="Industry" value="@Model.Industry" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Quy mô công ty</label>
                        <select class="form-select" name="CompanySize">
                            <option value="1-10" selected="@(Model.CompanySize == "1-10" ? "selected" : null)">1-10</option>
                            <option value="11-50" selected="@(Model.CompanySize == "11-50" ? "selected" : null)">11-50</option>
                            <option value="51-200" selected="@(Model.CompanySize == "51-200" ? "selected" : null)">51-200</option>
                            <option value="201-500" selected="@(Model.CompanySize == "201-500" ? "selected" : null)">201-500</option>
                            <option value="501-1000" selected="@(Model.CompanySize == "501-1000" ? "selected" : null)">501-1000</option>
                            <option value="1000+" selected="@(Model.CompanySize == "1000+" ? "selected" : null)">1000+</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Thành phố</label>
                        <input class="form-control" type="text" name="City" value="@Model.City" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Địa chỉ</label>
                        <input class="form-control" type="text" name="Address" value="@Model.Address" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Giới thiệu công ty</label>
                        <textarea class="form-control" name="Description" rows="4">@Model.Description</textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsVerified" value="true" id="chkXacThuc" checked="@(Model.IsVerified ? "checked" : null)" />
                            <label class="form-check-label" for="chkXacThuc">Đã xác thực (hiển thị huy hiệu "Đã xác thực")</label>
                        </div>
                    </div>
                </div>

                <button class="btn btn-accent mt-4 px-4" type="submit"><i class="fa-solid fa-check me-1"></i>Lưu thay đổi</button>
                <a class="btn btn-outline-secondary mt-4 px-4" href="@Url.Action("Details", new { id = Model.Id })">Huỷ</a>
            }
        </div>
    </div>
</div>
