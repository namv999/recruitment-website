@using DoAnLapTrinhWeb.Models
@model List<Company>
@{
    ViewBag.Title = "Danh sách công ty";
    Layout = "~/Views/Shared/_LayoutTuyenDung.cshtml";
    List<Job> dsJob = (List<Job>)ViewBag.DsJob;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="section-title mb-0">Danh sách công ty (@Model.Count)</h5>
    <a class="btn btn-accent" href="@Url.Action("Create")"><i class="fa-solid fa-plus me-1"></i>Đăng ký công ty mới</a>
</div>

<div class="row g-3">
    @foreach (Company ct in Model)
    {
        int soTinDangTuyen = dsJob.Count(j => j.CompanyId == ct.Id && j.Status == "published");

        <div class="col-md-6 col-lg-4">
            <div class="bg-white rounded-4 shadow-sm p-3 h-100">
                <div class="d-flex align-items-center mb-2">
                    <img class="company-logo me-2" src="@ct.LogoUrl" onerror="this.src='https://via.placeholder.com/56?text=Logo'" alt="@ct.Name" />
                    <div>
                        <a href="@Url.Action("Details", new { id = ct.Id })" class="fw-semibold text-decoration-none">
                            @ct.Name
                            @if (ct.IsVerified)
                            {
                                <i class="fa-solid fa-circle-check text-success ms-1" title="Đã xác thực"></i>
                            }
                        </a>
                        <div class="small text-muted">@ct.City</div>
                    </div>
                </div>
                <div class="small text-muted mb-2">
                    <i class="fa-solid fa-industry me-1"></i>@ct.Industry
                    <span class="mx-1">|</span>@ct.CompanySize nhân viên
                </div>
                <span class="badge bg-light text-dark border">@soTinDangTuyen tin đang tuyển</span>
                <div class="mt-3 d-flex gap-2">
                    <a class="btn btn-outline-primary btn-sm flex-fill" href="@Url.Action("Details", new { id = ct.Id })">Xem trang</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Edit", new { id = ct.Id })"><i class="fa-solid fa-pen"></i></a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <p class="text-muted text-center my-4">Chưa có công ty nào được đăng ký.</p>
}
