@using DoAnLapTrinhWeb.Models
@model CV
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_LayoutTuyenDung.cshtml";
    Candidate uv = (Candidate)ViewBag.UngVien;
}

<div class="bg-white rounded-4 shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap">
        <div>
            <a class="text-decoration-none small" href="@Url.Action("UngVien", "TuyenDung", new { id = uv.Id })">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại hồ sơ
            </a>
            <h3 class="fw-bold mt-2 mb-1"><i class="fa-solid fa-file-lines text-primary me-2"></i>@Model.Title</h3>
            <div class="text-muted small">
                Chủ sở hữu: @uv.FullName &middot; Tải lên: @Model.UploadedAt.ToString("dd/MM/yyyy")
                @if (Model.IsDefault)
                {
                    <span class="badge bg-light text-dark border ms-2">CV mặc định</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.FileUrl))
        {
            <a class="btn btn-accent" href="@Model.FileUrl" target="_blank"><i class="fa-solid fa-download me-1"></i>Tải CV gốc</a>
        }
    </div>

    <hr />

    <h6 class="fw-bold">Nội dung CV (trích xuất)</h6>
    <div class="p-3 bg-light rounded-3" style="white-space:pre-line">
        @Model.ParsedText
    </div>
</div>
